{
  "title": "Crypto Agent - Business Metrics",
  "tags": ["crypto-agent", "business", "articles"],
  "timezone": "browser",
  "schemaVersion": 16,
  "version": 0,
  "refresh": "30s",
  "panels": [
      {
        "id": 1,
        "title": "Total Articles",
        "type": "singlestat",
        "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "count(news_articles)",
            "refId": "A"
          }
        ],
        "format": "short",
        "valueName": "current",
        "colorBackground": false,
        "sparkline": {
          "show": true,
          "lineColor": "rgb(31, 120, 193)"
        }
      },
      {
        "id": 2,
        "title": "Articles with Embeddings",
        "type": "singlestat",
        "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
        "targets": [
          {
            "expr": "count(news_articles{has_embedding=\"true\"})",
            "refId": "A"
          }
        ],
        "format": "short",
        "valueName": "current",
        "colorBackground": false,
        "sparkline": {
          "show": true,
          "lineColor": "rgb(50, 172, 45)"
        }
      },
      {
        "id": 3,
        "title": "Articles with Sentiment",
        "type": "singlestat",
        "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "count(news_articles{sentiment!=\"\"})",
            "refId": "A"
          }
        ],
        "format": "short",
        "valueName": "current",
        "colorBackground": false,
        "sparkline": {
          "show": true,
          "lineColor": "rgb(237, 129, 40)"
        }
      },
      {
        "id": 4,
        "title": "Embedding Coverage",
        "type": "singlestat",
        "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0},
        "targets": [
          {
            "expr": "(count(news_articles{has_embedding=\"true\"}) / count(news_articles)) * 100",
            "refId": "A"
          }
        ],
        "format": "percent",
        "valueName": "current",
        "colorBackground": true,
        "thresholds": "50,90",
        "colors": ["#d44a3a", "#e0b400", "#299c46"]
      },
      {
        "id": 5,
        "title": "Articles by Source",
        "type": "piechart",
        "gridPos": {"h": 10, "w": 12, "x": 0, "y": 6},
        "targets": [
          {
            "expr": "count by (source) (news_articles)",
            "legendFormat": "{{source}}",
            "refId": "A"
          }
        ],
        "pieType": "donut",
        "legend": {
          "show": true,
          "values": true,
          "percentage": true
        }
      },
      {
        "id": 6,
        "title": "Sentiment Distribution",
        "type": "piechart",
        "gridPos": {"h": 10, "w": 12, "x": 12, "y": 6},
        "targets": [
          {
            "expr": "count by (sentiment) (news_articles{sentiment!=\"\"})",
            "legendFormat": "{{sentiment}}",
            "refId": "A"
          }
        ],
        "pieType": "pie",
        "legend": {
          "show": true,
          "values": true,
          "percentage": true
        },
        "colors": [
          "#73BF69",
          "#F2495C",
          "#5794F2"
        ]
      },
      {
        "id": 7,
        "title": "Articles Over Time",
        "type": "graph",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "count_over_time(news_articles[1h])",
            "legendFormat": "Total Articles",
            "refId": "A"
          },
          {
            "expr": "count_over_time(news_articles{has_embedding=\"true\"}[1h])",
            "legendFormat": "With Embeddings",
            "refId": "B"
          },
          {
            "expr": "count_over_time(news_articles{sentiment!=\"\"}[1h])",
            "legendFormat": "With Sentiment",
            "refId": "C"
          }
        ],
        "yaxes": [
          {"label": "Articles", "show": true},
          {"show": true}
        ],
        "bars": false,
        "lines": true,
        "fill": 1,
        "stack": false
      },
      {
        "id": 8,
        "title": "Top Mentioned Tokens",
        "type": "table",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
        "targets": [
          {
            "expr": "topk(10, count by (token) (news_articles_tokens))",
            "format": "table",
            "refId": "A"
          }
        ],
        "columns": [
          {"text": "Token", "value": "token"},
          {"text": "Mentions", "value": "Value"}
        ],
        "sort": {"col": 1, "desc": true}
      },
      {
        "id": 9,
        "title": "Avg Confidence Score by Sentiment",
        "type": "bargauge",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
        "targets": [
          {
            "expr": "avg by (sentiment) (news_articles_confidence_score{sentiment!=\"\"})",
            "legendFormat": "{{sentiment}}",
            "refId": "A"
          }
        ],
        "orientation": "horizontal",
        "displayMode": "gradient",
        "min": 0,
        "max": 1
      },
      {
        "id": 10,
        "title": "Recent Articles (Last 24h)",
        "type": "table",
        "gridPos": {"h": 10, "w": 24, "x": 0, "y": 32},
        "targets": [
          {
            "expr": "news_articles{created_at > \"now-24h\"}",
            "format": "table",
            "refId": "A"
          }
        ],
        "columns": [
          {"text": "Title", "value": "title"},
          {"text": "Source", "value": "source"},
          {"text": "Sentiment", "value": "sentiment"},
          {"text": "Confidence", "value": "confidence_score"},
          {"text": "Tokens", "value": "tokens_mentioned"},
          {"text": "Created", "value": "created_at"}
        ],
        "sort": {"col": 5, "desc": true},
        "pageSize": 10
      }
    ]
}

